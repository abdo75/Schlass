#!/bin/bash
set -e

echo "Running pre-commit checks..."

# Go lint
echo "→ Go lint"
golangci-lint run ./...

# Go unit tests
echo "→ Go unit tests"
go test ./internal/... -count=1

# Frontend lint
echo "→ Frontend lint"
cd web && npx eslint src/ --max-warnings=0

# Frontend tests
echo "→ Frontend tests"
npx vitest run

echo "All checks passed."
