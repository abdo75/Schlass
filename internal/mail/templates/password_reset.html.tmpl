<!doctype html>
<html>
  <body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #111827; padding: 28px 28px 24px; max-width: 480px; margin: 0 auto">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px">
      <span style="display: inline-block; width: 24px; height: 24px; border-radius: 6px; background: oklch(0.55 0.14 180); color: #fff; text-align: center; line-height: 24px; font-size: 13px; font-weight: 700">S</span>
      <span style="font-size: 14px; font-weight: 600; color: #171717">{{.InstanceName}}</span>
    </div>

    <h2 style="font-size: 18px; font-weight: 600; margin: 0 0 14px">Reset your password</h2>
    <p style="font-size: 14px; color: #171717; line-height: 1.6; margin: 0 0 14px">Hi {{.EmailLocalPart}},</p>
    <p style="font-size: 14px; color: #171717; line-height: 1.6; margin: 0 0 14px">
      We received a request to reset the password for your {{.InstanceName}} account. Click the button below to choose a new password.
    </p>

    <p style="margin: 8px 0 18px">
      <a href="{{.ResetURL}}" style="display: inline-block; height: 38px; line-height: 38px; padding: 0 20px; background: oklch(0.55 0.14 180); color: #fff; text-decoration: none; border-radius: 7px; font-size: 14px; font-weight: 600">Reset password</a>
    </p>

    <p style="font-size: 13px; color: #525252; margin: 0 0 14px">Or copy and paste this link into your browser:</p>
    <div style="background: #fafafa; border: 1px solid #f3f4f6; border-radius: 7px; padding: 10px 12px; font-family: ui-monospace, monospace; font-size: 11.5px; color: #525252; word-break: break-all; margin-bottom: 18px">{{.ResetURL}}</div>

    <p style="font-size: 13px; color: #525252; line-height: 1.6; margin: 0 0 14px">This link expires in 30 minutes and can only be used once.</p>
    <p style="font-size: 13px; color: #525252; line-height: 1.6; margin: 0 0 14px">If you didn't request a password reset, you can safely ignore this email — your password won't be changed.</p>

    <div style="padding-top: 16px; border-top: 1px solid #f3f4f6; font-size: 12px; color: #737373; line-height: 1.5; margin-top: 24px">
      Sent by {{.InstanceName}}. You're receiving this because someone requested a password reset for your account.
    </div>
  </body>
</html>
